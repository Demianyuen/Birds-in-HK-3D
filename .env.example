# Request a free key from 3dmap@landsd.gov.hk.
# This server-only variable is never included in the browser bundle.
CSDI_3D_API_KEY=
# Optional Google Maps 3D context. This key must be restricted to approved browser origins.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
# Standalone multiplayer host (WSS in production); never a credential.
VITE_WORLD_SERVER_URL=

# Open-world memorial (flowers, messages, shared sky, chat) — see docs/open-world-setup.md
# Browser (public by design; row-level security limits what it can read):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only (Vercel functions in api/ and the Vite dev server). Never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Long random string (16+ characters) for the moderation page /moderate.html.
MODERATOR_TOKEN=
# Optional: salt for hashing visitor IPs for rate limiting.
RATE_LIMIT_SALT=
